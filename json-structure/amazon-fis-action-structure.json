      "example": "Stop EC2 instances"
    },
    "parameters": {
      "type": "object",
      "description": "Action parameters",
      "additionalProperties": {
        "type": "object"
      }
    },
    "targets": {
      "type": "object",
      "description": "Target definitions",
      "additionalProperties": {
        "type": "object"
      }
    },
    "tags": {
      "type": "object",
      "description": "Resource tags",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "name": "Action"
}